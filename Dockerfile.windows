# escape=`
FROM python:3.11-windowsservercore-ltsc2022

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN New-Item -ItemType Directory -Path C:\app\database -Force

EXPOSE 5000

ENV FLASK_APP=app.py
ENV FLASK_DEBUG=0
ENV AGENDA_PORT=5000
ENV DATABASE_URL=sqlite:///C:/app/database/agenda.db

CMD ["waitress-serve", "--port=5000", "--host=0.0.0.0", "app:app"]
